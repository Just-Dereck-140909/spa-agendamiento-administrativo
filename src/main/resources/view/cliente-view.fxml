<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.org.wellness.spa.agendamiento.administrativo.controller.cliente.ClientesController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>
            <Label fx:id="lblNombreEmpresa" text="Wellness Spa" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblTituloSeccion" text="Gestión de Clientes" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnNuevoCliente" onAction="#handleNuevoClienteAction" text="Nuevo Cliente" />
                <Button fx:id="btnActualizarCliente" onAction="#handleActualizarClienteAction" text="Actualizar" />
                <Button fx:id="btnEliminarCliente" onAction="#handleEliminarClienteAction" text="Eliminar" />
            </HBox>

            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colAtributo1" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colAtributo2" prefWidth="150" text="Nombre" />
                    <TableColumn fx:id="colAtributo3" prefWidth="150" text="Apellido" />
                    <TableColumn fx:id="colAtributo4" prefWidth="130" text="Teléfono" />
                    <TableColumn fx:id="colAtributo5" prefWidth="180" text="Correo" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="10" />
            </padding>
            <Button fx:id="btnVolverMenu" onAction="#handleVolverMenuAction" text="Volver al menú" />
        </HBox>
    </bottom>

</BorderPane>