<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" stylesheets="main/resources/css/cita/citas-view.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.org.wellness.spa.agendamiento.administrativo.controller.cita.CitasController">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <Label fx:id="lblNombreEmpresa" text="Wellness Spa" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblTituloSeccion" text="Gestión de Citas" />
        </HBox>
    </top>

    <!-- ================= CONTENIDO CENTRAL ================= -->
    <center>
        <VBox spacing="15" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <!-- Barra de herramientas con las acciones del CRUD -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Button fx:id="btnNuevaCita" onAction="#handleNuevaCitaAction" text="Nueva Cita" />
                <Button fx:id="btnActualizarCita" onAction="#handleActualizarCitaAction" text="Actualizar" />
                <Button fx:id="btnEliminarCita" onAction="#handleEliminarCitaAction" text="Eliminar" />
            </HBox>

            <!-- Tabla de citas -->
            <TableView fx:id="tablaCitas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdCita" prefWidth="70" text="ID" />
                    <TableColumn fx:id="colCliente" prefWidth="130" text="Cliente" />
                    <TableColumn fx:id="colTrabajador" prefWidth="130" text="Trabajador" />
                    <TableColumn fx:id="colTratamiento" prefWidth="140" text="Tratamiento" />
                    <TableColumn fx:id="colFecha" prefWidth="90" text="Fecha" />
                    <TableColumn fx:id="colHora" prefWidth="70" text="Hora" />
                    <TableColumn fx:id="colEstado" prefWidth="100" text="Estado" />
                </columns>
            <columnResizePolicy>
            </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <!-- ================= FOOTER ================= -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="10" />
            </padding>

            <Button fx:id="btnVolverMenu" onAction="#handleVolverMenuAction" text="Volver al menú" />
        </HBox>
    </bottom>

</BorderPane>
