<AnchorPane id="AnchorPane" prefHeight="525.0" prefWidth="500.0" styleClass="mainFxmlClass" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21.0.1" fx:controller="main.java.org.wellness.spa.agendamiento.administrativo.controller.recepcionista.LoginController">
