<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            stylesheets="main/resources/css/tratamiento/tratamiento-view.css" 
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            
            fx:controller="main.java.org.wellness.spa.agendamiento.administrativo.controller.tratamiento.TratamientosController">

    <!-- ================= HEADER ================= -->

    <top>

        <HBox alignment="CENTER_LEFT" spacing="10" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <Label fx:id="lblNombreEmpresa" text="Wellness Spa" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblTituloSeccion" text="Gestión de Tratamientos" />

        </HBox>

    </top>

    <!-- ================= CONTENIDO CENTRAL ================= -->

    <center>

        <VBox spacing="15" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="10" left="20" right="20" top="10" />
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">

                <Button
                    fx:id="btnNuevoTratamientos"
                    onAction="#handleNuevoTratamientosAction"
                    text="Nuevo Tratamiento" />

                <Button
                    fx:id="btnActualizarTratamientos"
                    onAction="#handleActualizarTratamientosAction"
                    text="Actualizar" />

                <Button
                    fx:id="btnEliminarTratamientos"
                    onAction="#handleEliminarTratamientosAction"
                    text="Eliminar" />

            </HBox>

            <TableView fx:id="tablaTratamientos" VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn
                        fx:id="colIdTratamiento"
                        prefWidth="100"
                        text="ID" />

                    <TableColumn
                        fx:id="colNombreTratamiento"
                        prefWidth="130"
                        text="Nombre" />

                    <TableColumn
                        fx:id="colCostoTratamiento"
                        prefWidth="130"
                        text="Costo" />

                    <TableColumn
                        fx:id="colDescripcionTratamiento"
                        prefWidth="130"
                        text="Descripción" />

                    <TableColumn
                        fx:id="colDuracionTratamiento"
                        prefWidth="110"
                        text="Duración" />

                </columns>

                <columnResizePolicy>
                  
                </columnResizePolicy>

            </TableView>

        </VBox>

    </center>

    <!-- ================= FOOTER ================= -->

    <bottom>

        <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15" left="20" right="20" top="10" />
            </padding>

            <Button
                fx:id="btnVolverMenu"
                onAction="#handleVolverMenuAction"
                text="Volver al menú" />

        </HBox>

    </bottom>

</BorderPane>