<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.org.wellness.spa.agendamiento.administrativo.controller.menuprincipal.MenuPrincipalController">

    <!-- ================= HEADER ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15" left="20" right="20" top="15" />
            </padding>

            <ImageView fx:id="imgLogo"
                       fitHeight="68.0"
                       fitWidth="57.0"
                       preserveRatio="true">
                <Image url="@../image/imagen-logo.png" />
            </ImageView>

            <Label fx:id="lblBienvenida"
                   text="Bienvenido al programa - Wellness Spa">
                <HBox.margin>
                    <Insets left="10" />
                </HBox.margin>
            </Label>

            <Region HBox.hgrow="ALWAYS" />

            <ImageView fx:id="imgIcono"
                       fitHeight="53.0"
                       fitWidth="85.0"
                       preserveRatio="true">
                <Image url="@../image/imagen-icono.png" />
            </ImageView>
        </HBox>
    </top>

    <!-- ================= MENU LATERAL ================= -->
    <left>
        <BorderPane prefWidth="270.0"
                    BorderPane.alignment="TOP_CENTER">

            <padding>
                <Insets bottom="20"
                        left="15"
                        right="15"
                        top="20" />
            </padding>

            <!-- Texto guia, fijo arriba -->
            <top>
                <Label fx:id="lblDescripcionMenu"
                       text="Selecciona una opción para administrar la información del spa."
                       wrapText="true"
                       BorderPane.alignment="TOP_LEFT" />
            </top>

            <!-- Botones, centrados en el espacio restante -->
            <center>
                <VBox alignment="CENTER"
                      spacing="15"
                      BorderPane.alignment="CENTER">

                    <GridPane hgap="10"
                              vgap="10">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" />
                            <ColumnConstraints percentWidth="50" />
                        </columnConstraints>

                        <rowConstraints>
                            <RowConstraints />
                            <RowConstraints />
                        </rowConstraints>

                        <Button fx:id="btnClientes"
                                maxWidth="Infinity"
                                onAction="#handleClientesAction"
                                text="Clientes"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0" />

                        <Button fx:id="btnTratamientos"
                                maxWidth="Infinity"
                                onAction="#handleTratamientosAction"
                                text="Tratamientos"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0" />

                        <Button fx:id="btnCitas"
                                maxWidth="Infinity"
                                onAction="#handleCitasAction"
                                text="Citas"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1" />

                        <Button fx:id="btnTrabajadores"
                                maxWidth="Infinity"
                                onAction="#handleTrabajadoresAction"
                                text="Trabajadores"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1" />
                    </GridPane>

                    <Button fx:id="btnCerrarSesion"
                            maxWidth="Infinity"
                            onAction="#handleCerrarSesionAction"
                            text="Cerrar Sesión">

                        <VBox.margin>
                            <Insets top="10" />
                        </VBox.margin>

                    </Button>

                </VBox>
            </center>
        </BorderPane>
    </left>

    <!-- ================= CONTENIDO CENTRAL ================= -->
    <center>
        <VBox spacing="10"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15"
                        left="10"
                        right="20"
                        top="15" />
            </padding>

            <Label fx:id="lblTituloTabla"
                   text="Resumen de Citas" />

            <TableView fx:id="tablaCitas"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="colNombreCliente"
                                 prefWidth="100"
                                 text="Nombre Cliente" />

                    <TableColumn fx:id="colApellidoCliente"
                                 prefWidth="100"
                                 text="Apellido Cliente" />

                    <TableColumn fx:id="colTrabajador"
                                 prefWidth="120"
                                 text="Trabajador" />

                    <TableColumn fx:id="colTratamiento"
                                 prefWidth="130"
                                 text="Tratamiento" />

                    <TableColumn fx:id="colDescripcionTratamiento"
                                 prefWidth="220"
                                 text="Descripción" />

                    <TableColumn fx:id="colHora"
                                 prefWidth="70"
                                 text="Hora" />

                    <TableColumn fx:id="colFecha"
                                 prefWidth="90"
                                 text="Fecha" />

                    <TableColumn fx:id="colEstado"
                                 prefWidth="100"
                                 text="Estado" />

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>