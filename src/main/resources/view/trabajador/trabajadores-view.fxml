<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0"
            prefWidth="1000.0"
            stylesheets="main/resources/css/trabajador/trabajadores-view.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="main.java.org.wellness.spa.agendamiento.administrativo.controller.trabajador.TrabajadorController">

    <!-- HEADER -->

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="10"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15"
                        left="20"
                        right="20"
                        top="15" />
            </padding>

            <Label fx:id="lblNombreEmpresa"
                   text="Wellness Spa" />

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblTituloSeccion"
                   text="Gestión de Trabajadores" />

        </HBox>
    </top>

    <!-- CONTENIDO CENTRAL -->

    <center>
        <VBox spacing="15"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="10"
                        left="20"
                        right="20"
                        top="10" />
            </padding>

            <!-- Barra de herramientas -->

            <HBox alignment="CENTER_LEFT"
                  spacing="10">

                <Button fx:id="btnNuevoTrabajador"
                        onAction="#handleNuevoTrabajadorAction"
                        text="Nuevo Trabajador" />

                <Button fx:id="btnActualizarTrabajador"
                        onAction="#handleActualizarTrabajadorAction"
                        text="Actualizar" />

                <Button fx:id="btnEliminarTrabajador"
                        onAction="#handleEliminarTrabajadorAction"
                        text="Eliminar" />

            </HBox>

            <!-- Tabla de trabajadores -->

           <TableView fx:id="tablaTrabajadores"
           VBox.vgrow="ALWAYS">

        <columns>

            <TableColumn fx:id="colIdTrabajador"
                         prefWidth="80"
                         text="ID" />

            <TableColumn fx:id="colNombre"
                         prefWidth="140"
                         text="Nombre" />

            <TableColumn fx:id="colApellido"
                         prefWidth="140"
                         text="Apellido" />

            <TableColumn fx:id="colOcupacion"
                         prefWidth="140"
                         text="Ocupación" />

            <TableColumn fx:id="colCorreoElectronico"
                         prefWidth="200"
                         text="Correo Electrónico" />

        </columns>

    </TableView>

        </VBox>
    </center>

    <!-- FOOTER -->

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets bottom="15"
                        left="20"
                        right="20"
                        top="10" />
            </padding>

            <Button fx:id="btnVolverMenu"
                    onAction="#handleVolverMenuAction"
                    text="Volver al menú" />

        </HBox>
    </bottom>

</BorderPane>